<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <RootNamespace>DependencyNavigator</RootNamespace>
    <AssemblyName>dotnet-dependency-navigator</AssemblyName>
  </PropertyGroup>

  <!-- Packaging as a .NET tool, started with "dotnet dependency-navigator" -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-dependency-navigator</ToolCommandName>
    <PackageId>dotnet-dependency-navigator</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ViewerTemplate.html" LogicalName="ViewerTemplate.html" />
    <None Update="architecture-tiers.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
  </ItemGroup>

</Project>
